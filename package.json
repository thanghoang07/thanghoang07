{
  "name": "thanghoang07-portfolio",
  "version": "1.0.0",
  "type": "module",
  "description": "Thang Hoang Duc Portfolio Website",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "lighthouse": "node scripts/performance-monitor.js",
    "lighthouse:ci": "lhci autorun",
    "performance": "npm run build && npm run lighthouse:ci",
    "performance:mobile": "node scripts/performance-monitor.js http://localhost:4173 3 mobile",
    "performance:report": "npm run performance",
    "test:build": "npm run build && npm run test:smoke",
    "ci:test": "npm run test:unit && npm run test:build",
    "ci:build": "npm run build",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:smoke": "node scripts/smoke-test.js"
  },
  "keywords": [
    "portfolio",
    "frontend",
    "developer"
  ],
  "author": "Thang Hoang Duc",
  "license": "MIT",
  "devDependencies": {
    "@lhci/cli": "^0.12.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "4.10.3",
    "chrome-launcher": "^1.0.0",
    "gh-pages": "^6.0.0",
    "lighthouse": "^11.0.0",
    "postcss": "^8.5.6",
    "puppeteer-core": "22.15.0",
    "rollup": "^4.0.0",
    "terser": "^5.44.0",
    "vite": "^5.4.0",
    "tailwindcss": "^3.3.0"
  }
}
